# CKAN dev image with the custom `umss` extension baked in (editable).
# Build context: the ckan-docker/ directory (so we can COPY ckan/ and src/).
#
# Difference vs Dockerfile.umss (production): editable install + the runtime
# bind mount (./src:/srv/app/src_extensions) keeps the extension hot-reloadable.

FROM ckan/ckan-dev:2.12

# Bake the umss extension (editable) so it's installed AND live-reloadable.
# The egg-link points to /srv/app/src_extensions/ckanext-umss, which the
# runtime bind mount replaces with the live source.
COPY --chown=ckan-sys:ckan-sys src/ckanext-umss /srv/app/src_extensions/ckanext-umss
USER root
RUN pip3 install -e /srv/app/src_extensions/ckanext-umss

# Standard ckan-docker additions (entrypoint scripts + patches), same as Dockerfile.dev
COPY --chown=ckan-sys:ckan-sys ckan/docker-entrypoint.d/* /docker-entrypoint.d/
COPY --chown=ckan-sys:ckan-sys ckan/patches ${APP_DIR}/patches

USER root

# Two 2.12 permission characteristics, both from the same cause — the images ship the CKAN source
# tree owned by `ckan-sys` with group read-only, and this image has to write to it:
#   1. the patch loop below modifies `ckan/views/*`, and as the `ckan` user `patch` cannot even
#      create its temp file in that directory (drwxr-xr-x) — the build fails.
#   2. the dev entrypoint rewrites `test-core.ini` on every boot and hits
#      `PermissionError: [Errno 13] Permission denied`.
RUN chmod g+w ${SRC_DIR}/ckan/test-core.ini

RUN for d in $APP_DIR/patches/*; do \
        if [ -d $d ]; then \
            for f in `ls $d/*.patch | sort -g`; do \
                cd $SRC_DIR/`basename "$d"` && echo "$0: Applying patch $f to $SRC_DIR/`basename $d`"; patch -p1 < "$f" ; \
            done ; \
        fi ; \
    done

USER ckan
