# CKAN dev image with the custom `umss` extension baked in (editable).
# Build context: the ckan-docker/ directory (so we can COPY ckan/ and src/).
#
# Difference vs Dockerfile.umss (production): editable install + the runtime
# bind mount (./src:/srv/app/src_extensions) keeps the extension hot-reloadable.
# Both images also carry ckanext-xloader 2.6.0 and the ckan-worker start script.

FROM ckan/ckan-dev:2.12

# Bake the umss extension (editable) so it's installed AND live-reloadable.
# The egg-link points to /srv/app/src_extensions/ckanext-umss, which the
# runtime bind mount replaces with the live source.
COPY --chown=ckan-sys:ckan-sys src/ckanext-umss /srv/app/src_extensions/ckanext-umss
USER root
RUN pip3 install -e /srv/app/src_extensions/ckanext-umss

# ckanext-xloader 2.6.0 replaces the DataPusher as the DataStore loader.
# Three steps, each for a measured reason:
#   1. `--no-deps -e` from the PyPI sdist: the editable install is required, not a style
#      choice. A non-editable one does NOT import in the dev image (pip 26 / setuptools 84
#      ship no `pkg_resources`, and the umss editable install writes an nspkg `.pth` that
#      fixes `ckanext.__path__` to the editable checkouts). The sdist and not `git+`:
#      `ckan/ckan-base:2.12` ships no git, so a `git+` install fails the production build.
#      `--no-deps` because its pins would otherwise move packages CKAN already runs on.
#   2. Its runtime dependencies, constrained by this image's own `pip freeze` (minus `-e`
#      and ` @ ` lines: pip refuses editable constraints). Measured: 15 packages added,
#      0 changed. `pip check` still names certifi/idna/urllib3 below xloader's floors;
#      that is the combination loader-eval Runs 4-5 validated, accepted on purpose.
#   3. An import check at build time, from the app dir, so a broken install fails the
#      build and not the first boot.
RUN cd ${SRC_DIR} && \
    pip3 download --no-deps --no-binary ckanext-xloader -d /tmp/xloader ckanext-xloader==2.6.0 && \
    mkdir ckanext-xloader && \
    tar -xzf /tmp/xloader/ckanext_xloader-2.6.0.tar.gz -C ckanext-xloader --strip-components=1 && \
    rm -rf /tmp/xloader && \
    pip3 install --no-deps -e ./ckanext-xloader && \
    pip3 freeze 2>/dev/null | grep -v -e '^-e' -e ' @ ' > /tmp/constraints.txt && \
    pip3 install -c /tmp/constraints.txt tabulator==1.53.5 Unidecode==1.4.0 chardet==7.6.0 zipp && \
    rm /tmp/constraints.txt && \
    cd ${APP_DIR} && python3 -c "import ckanext.xloader.plugin"

# Standard ckan-docker additions (entrypoint scripts + patches), same as Dockerfile.dev
COPY --chown=ckan-sys:ckan-sys ckan/docker-entrypoint.d/* /docker-entrypoint.d/
COPY --chown=ckan-sys:ckan-sys ckan/patches ${APP_DIR}/patches

# Start script of the `ckan-worker` service. Under /srv/worker, outside every dev volume
# (/srv/app, /usr/local/bin, site-packages), so a stale volume cannot hide it.
COPY --chown=ckan-sys:ckan-sys --chmod=755 ckan/worker/start_ckan_worker.sh /srv/worker/start_ckan_worker.sh

USER root

# Two 2.12 permission characteristics, both from the same cause — the images ship the CKAN source
# tree owned by `ckan-sys` with group read-only, and this image has to write to it:
#   1. the patch loop below modifies `ckan/views/*`, and as the `ckan` user `patch` cannot even
#      create its temp file in that directory (drwxr-xr-x) — the build fails.
#   2. the dev entrypoint rewrites `test-core.ini` on every boot and hits
#      `PermissionError: [Errno 13] Permission denied`.
RUN chmod g+w ${SRC_DIR}/ckan/test-core.ini

RUN for d in $APP_DIR/patches/*; do \
        if [ -d $d ]; then \
            for f in `ls $d/*.patch | sort -g`; do \
                cd $SRC_DIR/`basename "$d"` && echo "$0: Applying patch $f to $SRC_DIR/`basename $d`"; patch -p1 < "$f" ; \
            done ; \
        fi ; \
    done

USER ckan
