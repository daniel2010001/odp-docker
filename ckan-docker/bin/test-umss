#!/usr/bin/env bash
#
# Corre la suite de `ckanext-umss` contra la base y el índice de **test**.
#
# NO corras `pytest --ckan-ini=test.ini` a mano dentro de `ckan-dev`. El
# contenedor exporta `CKAN_SQLALCHEMY_URL`, `CKAN_SOLR_URL` y `CKAN_SITE_ID`, y
# `update_config()` (`ckan/config/environment.py`) les da precedencia sobre
# cualquier ini vía `CONFIG_FROM_ENV_VARS`. Una corrida directa apunta entonces a
# `ckandb` y al core `ckan` compartido, y como `clean_db` trunca, **borra la base
# de dev**. Medido el 2026-09-21: una corrida la dejó con sólo filas de factory.
#
# Este script deriva las URLs de test de los valores propios de la app *dentro*
# del contenedor, así no pueden desincronizarse de `.env`, y se niega a correr si
# alguna no termina en `_test`.
#
# Uso: bin/test-umss [argumentos extra para pytest...]
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
COMPOSE="${ROOT}/../docker-compose.dev.unified.yml"

if [[ ! -f "$COMPOSE" ]]; then
	echo "test-umss: no encuentro ${COMPOSE}" >&2
	exit 1
fi

docker compose -f "$COMPOSE" exec -T ckan-dev bash -lc '
set -euo pipefail

# Derivar el destino de test del último SEGMENTO del path, no del string
# entero: un `?query` o un `#fragment` no debe poder colar el nombre de dev, y
# un segmento que no sea un nombre de dev conocido se rechaza.
#
# NADA de comillas simples en todo este payload: va dentro del `bash -lc`
# remoto y una suelta lo termina antes de tiempo. `bash -n` sobre el archivo no
# lo ve —la sintaxis suelta está bien— y el fallo aparece en expansión: medido,
# el shell local expande `$url` sin comillas y con `set -u` aborta la invocación.
derive() {
	local url="$1" base rest last dst
	base="${url%%[?#]*}"
	rest="${url#"$base"}"
	last="${base##*/}"
	case "$last" in
	ckandb | ckan) dst=ckan_test ;;
	datastore) dst=datastore_test ;;
	*)
		echo "test-umss: $url no termina en un nombre de dev conocido (último segmento: $last)" >&2
		return 1
		;;
	esac
	printf "%s" "${base%$last}$dst$rest"
}

SQL="$(derive "$CKAN_SQLALCHEMY_URL")" || exit 1
DSW="$(derive "$CKAN_DATASTORE_WRITE_URL")" || exit 1
DSR="$(derive "$CKAN_DATASTORE_READ_URL")" || exit 1
SOLR="$(derive "$CKAN_SOLR_URL")" || exit 1

# La guarda mira el SEGMENTO del path, no el string entero.
for pair in "SQL=$SQL" "DSW=$DSW" "DSR=$DSR" "SOLR=$SOLR"; do
	seg="${pair#*=}"; seg="${seg%%[?#]*}"; seg="${seg##*/}"
	case "$seg" in
	*_test) ;;
	*)
		echo "test-umss: me niego a correr, ${pair} no apunta a test" >&2
		exit 1
		;;
	esac
done

# La imagen de Solr precrea sólo el core `ckan`. El `configSet` absoluto es
# obligatorio: un nombre suelto se resuelve contra `<solr.home>/configsets`, que
# no tiene el esquema de CKAN. Idempotente.
CORE="${SOLR##*/}"
python - "$SOLR" "$CORE" <<PY
import json, sys, urllib.request, urllib.error

solr, core = sys.argv[1], sys.argv[2]
base = solr.rsplit("/solr/", 1)[0]
with urllib.request.urlopen(base + "/solr/admin/cores?action=STATUS") as r:
    if core in json.load(r).get("status", {}):
        sys.exit(0)
url = (base + "/solr/admin/cores?action=CREATE&name=" + core +
       "&configSet=/opt/solr/server/solr/configsets/ckan")
try:
    with urllib.request.urlopen(url) as r:
        print("test-umss: core creado:", json.load(r))
except urllib.error.HTTPError as e:
    print("test-umss: no pude crear el core %s: %s" % (core, e.read().decode()[:300]), file=sys.stderr)
    sys.exit(1)
PY

export CKAN_SQLALCHEMY_URL="$SQL"
export CKAN_DATASTORE_WRITE_URL="$DSW"
export CKAN_DATASTORE_READ_URL="$DSR"
export CKAN_SOLR_URL="$SOLR"
export CKAN_SITE_ID="test.ckan.net"

cd /srv/app/src_extensions/ckanext-umss
python -m pytest --ckan-ini=test.ini "$@"
' _ "$@"
