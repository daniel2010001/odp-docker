#!/usr/bin/env bash
#
# Corre la suite de `ckanext-umss` contra la base y el índice de **test**.
#
# NO corras `pytest --ckan-ini=test.ini` a mano dentro de `ckan-dev`. El
# contenedor exporta `CKAN_SQLALCHEMY_URL`, `CKAN_SOLR_URL` y `CKAN_SITE_ID`, y
# `update_config()` (`ckan/config/environment.py`) les da precedencia sobre
# cualquier ini vía `CONFIG_FROM_ENV_VARS`. Una corrida directa apunta entonces a
# `ckandb` y al core `ckan` compartido. `clean_db` no trunca: refleja el esquema y
# hace `drop_all`, así que **borra el esquema y los datos de la base de dev**.
# Medido el 2026-09-21: una corrida la dejó con sólo filas de factory.
#
# Desde el 2026-09-22 la suite además se niega a arrancar en ese estado
# (`conftest.py` + `ckanext/umss/tests/target_guard.py`); esta guarda del llamador
# sigue siendo la primera línea, la que evita que el problema llegue a existir.
#
# Este script deriva las URLs de test de los valores propios de la app *dentro*
# del contenedor, así no pueden desincronizarse de `.env`, y se niega a correr si
# alguna no termina en `_test`.
#
# Uso: bin/test-umss [argumentos extra para pytest...]
set -euo pipefail

ROOT_SELF="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
. "${ROOT_SELF}/_common.sh"

if [[ ! -f "$COMPOSE_FILE" ]]; then
	echo "test-umss: no encuentro ${COMPOSE_FILE}" >&2
	exit 1
fi

docker compose -f "$COMPOSE_FILE" exec -T ckan-dev bash -lc '
set -euo pipefail

# Derivar el destino de test del último SEGMENTO del path, no del string
# entero: un `?query` o un `#fragment` no debe poder colar el nombre de dev, y
# un segmento que no sea un nombre de dev conocido se rechaza.
#
# NADA de comillas simples en todo este payload: va dentro del `bash -lc`
# remoto y una suelta lo termina antes de tiempo. `bash -n` sobre el archivo no
# lo ve —la sintaxis suelta está bien— y el fallo aparece en expansión: medido,
# el shell local expande `$url` sin comillas y con `set -u` aborta la invocación.
derive() {
	local url="$1" base rest last dst
	base="${url%%[?#]*}"
	rest="${url#"$base"}"
	last="${base##*/}"
	case "$last" in
	ckandb | ckan) dst=ckan_test ;;
	datastore) dst=datastore_test ;;
	*)
		echo "test-umss: $url no termina en un nombre de dev conocido (último segmento: $last)" >&2
		return 1
		;;
	esac
	printf "%s" "${base%$last}$dst$rest"
}

SQL="$(derive "$CKAN_SQLALCHEMY_URL")" || exit 1
DSW="$(derive "$CKAN_DATASTORE_WRITE_URL")" || exit 1
DSR="$(derive "$CKAN_DATASTORE_READ_URL")" || exit 1
SOLR="$(derive "$CKAN_SOLR_URL")" || exit 1

# La guarda mira el SEGMENTO del path, no el string entero.
for pair in "SQL=$SQL" "DSW=$DSW" "DSR=$DSR" "SOLR=$SOLR"; do
	seg="${pair#*=}"; seg="${seg%%[?#]*}"; seg="${seg##*/}"
	case "$seg" in
	*_test) ;;
	*)
		echo "test-umss: me niego a correr, ${pair} no apunta a test" >&2
		exit 1
		;;
	esac
done

# La imagen de Solr precrea sólo el core `ckan`. El `configSet` absoluto es
# obligatorio: un nombre suelto se resuelve contra `<solr.home>/configsets`, que
# no tiene el esquema de CKAN. Idempotente.
CORE="${SOLR##*/}"
# El delimitador va entre comillas (dobles: este payload no admite simples) para
# que bash entregue el Python tal cual. Sin comillas, bash ejecutaba como comando
# lo que el comentario de abajo cita entre comillas invertidas: cada log empezaba
# con "Try timeout --help". Python recibe sus datos por argv, no por expansión.
# Lo vigila `tests/test-heredoc-quoting.sh`.
python - "$SOLR" "$CORE" <<"PY"
import json, sys, urllib.request, urllib.error

solr, core = sys.argv[1], sys.argv[2]
base = solr.rsplit("/solr/", 1)[0]
# `timeout` no es decorativo: sin él, un Solr que acepta la conexión y no contesta
# deja al runner colgado para siempre, y el síntoma (una suite que nunca termina)
# no dice nada sobre la causa.
with urllib.request.urlopen(base + "/solr/admin/cores?action=STATUS", timeout=10) as r:
    if core in json.load(r).get("status", {}):
        sys.exit(0)
url = (base + "/solr/admin/cores?action=CREATE&name=" + core +
       "&configSet=/opt/solr/server/solr/configsets/ckan")
try:
    with urllib.request.urlopen(url, timeout=30) as r:
        print("test-umss: core creado:", json.load(r))
except urllib.error.HTTPError as e:
    print("test-umss: no pude crear el core %s: %s" % (core, e.read().decode()[:300]), file=sys.stderr)
    sys.exit(1)
PY

export CKAN_SQLALCHEMY_URL="$SQL"
export CKAN_DATASTORE_WRITE_URL="$DSW"
export CKAN_DATASTORE_READ_URL="$DSR"
export CKAN_SOLR_URL="$SOLR"
export CKAN_SITE_ID="test.ckan.net"

# `datastore_test` nace vacía: `30_setup_test_databases.sh` sólo hace
# `CREATE DATABASE ... OWNER "$CKAN_DB_USER"`, sin el esquema que
# `ckan datastore set-permissions` crea. Sin él, cada `datastore_create` de la
# suite falla con `function populate_full_text_trigger() does not exist` y
# `datastore_info` con `relation "_table_metadata" does not exist` (medido el
# 2026-10-17). El SQL se le pide a CKAN en vez de copiarlo acá, para que no se
# desincronice de la versión que trae la imagen, y se aplica una sola vez: si
# los dos objetos ya están, esta corrida no imprime nada.
#
# Va después de los `export`s porque los toma de las URLs de test, y antes de
# `pytest` porque la suite no arranca sin el esquema. El chequeo de la ruta no
# alcanza: la ruta de la URL no es la base que el driver abre. Con psycopg2
# 2.9.12, `.../datastore_test?dbname=datastore` abre `datastore` (medido en este
# stack el 2026-10-17), y `target_guard.py` documenta el mismo efecto para
# `?database=` vía SQLAlchemy. Por eso lo primero que se ejecuta es
# `select current_database()` y todo lo demás depende de esa respuesta.
#
# El delimitador va entre
# comillas (dobles: este payload no admite simples) para que bash entregue el
# Python tal cual; lo vigila `tests/test-heredoc-quoting.sh`, y todo lo demás
# `tests/test-umss-datastore-schema.sh`.
python - "$SQL" "$DSW" "$DSR" <<"PY"
import sys
from urllib.parse import unquote, urlsplit

# Lo que `set-permissions` crea y la suite necesita. Se pregunta por el nombre en
# el catálogo, que se puede leer siempre, y no por el privilegio: que el rol de
# la URL de escritura sea el dueño de la base se prueba en la corrida real.
PROBES = (
    ("populate_full_text_trigger",
     "select count(*) from pg_proc where proname = %s"),
    ("_table_metadata",
     "select count(*) from pg_views where viewname = %s"),
)


def split_url(url):
    parts = urlsplit(url)
    return unquote(parts.username or ""), unquote(parts.path.lstrip("/"))


def missing_objects(cur):
    missing = []
    for name, query in PROBES:
        cur.execute(query, (name,))
        if cur.fetchone()[0] == 0:
            missing.append(name)
    return missing


def opened_problem(opened, expected):
    # La ruta de la URL no es la base que el driver abre: con psycopg2 2.9.12,
    # `.../datastore_test?dbname=datastore` abre `datastore` (medido en este stack
    # el 2026-10-17), y `create_connect_args()` de SQLAlchemy resuelve `?database=`
    # igual. La única fuente de verdad sobre lo que se abrió es el servidor.
    if opened != expected:
        return "el driver abrió " + str(opened) + ", no " + expected
    if not opened.endswith("_test"):
        return "el driver abrió " + str(opened) + ", que no es una base de test"
    return None


def connect_problem(sql, expected):
    # psql ejecuta `\connect "x"`; psycopg2 no, y por eso esas líneas se tiran.
    # Antes de tirarlas hay que comprobar que ninguna apuntaba a otra base: el SQL
    # trae `\connect {datastoredb}` hoy, y eso es una observación, no un contrato.
    seen = 0
    for line in sql.splitlines():
        stripped = line.strip()
        if not stripped.startswith("\\"):
            continue
        # `\connect -reuse-previous=on db` es legal: los modificadores se saltean.
        words = [w for w in stripped[1:].split() if not w.startswith("-")]
        if not words or words[0] not in ("connect", "c"):
            continue
        seen += 1
        if len(words) < 2:
            return "el meta-comando " + stripped + " no nombra ninguna base"
        target = words[1]
        # La comilla doble se escribe `chr(34)` porque este payload no admite
        # comillas simples ni siquiera dentro del heredoc: el `bash -lc` entero
        # es un solo string entre simples del lado del host, y una suelta lo
        # termina antes de tiempo.
        target = target.strip(chr(34))
        if target != expected:
            return "el SQL se conecta a " + target + ", no a " + expected
    if seen == 0:
        return "el SQL no se conecta a ninguna base: no puedo verificar el destino"
    return None


def strip_meta(sql):
    # Toda línea que empieza con barra invertida es un meta-comando de psql. No
    # sobrevive ninguna: el destino ya se verificó, y la conexión es la de la URL
    # de escritura.
    return "\n".join(
        line for line in sql.splitlines() if not line.strip().startswith("\\")
    )


def main(argv):
    # Las dos importaciones que sólo existen dentro del contenedor van acá
    # adentro: así `tests/test-umss-datastore-schema.sh` carga este mismo archivo
    # en el host y ejercita las funciones puras sin CKAN y sin base de datos.
    import psycopg2
    from ckanext.datastore.cli import permissions_sql

    mainuser, maindb = split_url(argv[0])
    writeuser, datastoredb = split_url(argv[1])
    readuser, _ = split_url(argv[2])

    if not datastoredb.endswith("_test"):
        print("test-umss: no aplico el esquema en " + datastoredb +
              ": no es una base de test", file=sys.stderr)
        return 1

    conn = psycopg2.connect(argv[1])
    try:
        # Primera sentencia y sin excepción: la base que se abrió de verdad. Si
        # no es la esperada, no se ejecuta nada más y esta conexión se cierra
        # sin commit.
        with conn.cursor() as cur:
            cur.execute("select current_database()")
            opened = cur.fetchone()[0]
        problem = opened_problem(opened, datastoredb)
        if problem is not None:
            print("test-umss: no aplico el esquema del DataStore: " + problem,
                  file=sys.stderr)
            return 1
        # De acá en adelante, la verificación de los `\connect` compara contra la
        # base que se abrió, no contra el nombre que decía la ruta.
        datastoredb = opened
        with conn.cursor() as cur:
            missing = missing_objects(cur)
        if not missing:
            return 0
        sql = permissions_sql(maindb=maindb, datastoredb=datastoredb,
                              mainuser=mainuser, writeuser=writeuser,
                              readuser=readuser)
        problem = connect_problem(sql, datastoredb)
        if problem is not None:
            # Nada se ejecutó: la única sentencia que corrió fue la sonda, y esta
            # conexión se cierra sin commit.
            print("test-umss: no aplico el esquema del DataStore: " + problem,
                  file=sys.stderr)
            return 1
        with conn.cursor() as cur:
            cur.execute(strip_meta(sql))
        conn.commit()
    finally:
        conn.close()
    print("test-umss: faltaba el esquema del DataStore en " + datastoredb +
          " (" + ", ".join(missing) +
          "); lo apliqué con set-permissions de CKAN")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
PY

cd /srv/app/src_extensions/ckanext-umss
python -m pytest --ckan-ini=test.ini "$@"
' _ "$@"
