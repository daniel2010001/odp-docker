# demo.env.example — secrets of the hs-node demo (docker-compose.hs.yml).
#
#   cp demo.env.example .env.demo && chmod 600 .env.demo
#
# Then fill every empty value with a fresh one, never a dev value
# (e.g. `openssl rand -base64 32` for secrets, `openssl rand -hex 24` for passwords:
# they go inside URLs, so keep them URL-safe). `.env.demo` is gitignored; never commit it.
#
# Every secret of ckan-docker/.env must be here: that file is shared with odp-dev,
# and a missing key passes the dev value through. tests/test-hs-demo-compose.sh
# enforces it.

# Public name of the portal; CKAN is served at api.<DEMO_HOST>. Not odp-dev's.
DEMO_HOST=demo.odp.hs.lan

# Portal session key (the root .env's, but fresh).
SESSION_SECRET=

# PostgreSQL names, here so the demo never depends on ckan-docker/.env's. The db
# service creates these users and databases on a fresh volume.
POSTGRES_USER=postgres
POSTGRES_DB=postgres
CKAN_DB_USER=ckandbuser
CKAN_DB=ckandb
DATASTORE_READONLY_USER=datastore_ro
DATASTORE_DB=datastore

# PostgreSQL passwords.
POSTGRES_PASSWORD=
CKAN_DB_PASSWORD=
DATASTORE_READONLY_PASSWORD=

# The same names and passwords inside CKAN's URLs:
#   CKAN_SQLALCHEMY_URL=postgresql://<CKAN_DB_USER>:<CKAN_DB_PASSWORD>@db/<CKAN_DB>
#   CKAN_DATASTORE_WRITE_URL=postgresql://<CKAN_DB_USER>:<CKAN_DB_PASSWORD>@db/<DATASTORE_DB>
#   CKAN_DATASTORE_READ_URL=postgresql://<DATASTORE_READONLY_USER>:<DATASTORE_READONLY_PASSWORD>@db/<DATASTORE_DB>
#   TEST_*: the same, on ckan_test and datastore_test.
CKAN_SQLALCHEMY_URL=
CKAN_DATASTORE_WRITE_URL=
CKAN_DATASTORE_READ_URL=
TEST_CKAN_SQLALCHEMY_URL=
TEST_CKAN_DATASTORE_WRITE_URL=
TEST_CKAN_DATASTORE_READ_URL=

# CKAN secrets. Both JWT values are the same `string:<secret>`.
CKAN___BEAKER__SESSION__SECRET=
CKAN___API_TOKEN__JWT__ENCODE__SECRET=
CKAN___API_TOKEN__JWT__DECODE__SECRET=
CKAN_SYSADMIN_PASSWORD=
CKAN_SMTP_PASSWORD=
