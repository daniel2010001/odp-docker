# Variables de `docker-compose.unified.yml` (producción). Copiar a `.env` en esta
# misma carpeta (la raíz del repo) y completar. Compose interpola el compose raíz
# desde ESTE `.env`, no desde `ckan-docker/.env`, que sólo alimenta el stack CKAN
# incluido. Ojo: una variable definida acá también pisa a la del mismo nombre en
# `ckan-docker/.env`, así que no repitas nombres de ese archivo.

# Clave del portal para sellar la cookie de sesión (AES-256-GCM). Obligatoria:
# sin ella el stack no arranca. Alta entropía, por ejemplo `openssl rand -base64 32`.
# Rotarla invalida todas las sesiones abiertas. Nunca la commitees.
SESSION_SECRET=
